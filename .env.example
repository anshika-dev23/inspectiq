# Copy to .env and fill in. Never commit .env.

# LLM provider switch: "ollama" (local) or "anthropic". Steps 1-2 make no LLM calls.
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# Embedding models are cached locally; do not contact the Hugging Face Hub.
# Set to 0 on a fresh machine (or in CI) so the models can be downloaded once.
HF_HUB_OFFLINE=1

# Observability (step 5)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
